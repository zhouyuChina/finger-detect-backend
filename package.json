{
  "name": "finger-detect-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:init": "node scripts/init-db.js",
    "db:view": "node scripts/view-db.js",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:init",
    "vercel-build": "node scripts/deploy.js && next build",
    "baota:deploy": "chmod +x scripts/baota-deploy.sh && ./scripts/baota-deploy.sh",
    "baota:init-db": "node scripts/init-production-db.js",
    "baota:setup": "npm run db:generate && npm run db:deploy && npm run baota:init-db"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-build-decoupled-document": "^44.3.0",
    "@ckeditor/ckeditor5-react": "^11.0.0",
    "@prisma/client": "^6.12.0",
    "@tailwindcss/typography": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lightningcss": "1.30.1",
    "multer": "^2.0.2",
    "next": "15.4.2",
    "prisma": "^6.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "^5.6.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "tailwindcss": "^4"
  }
}
