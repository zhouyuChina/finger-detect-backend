generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WechatUser {
  id           String                  @id @default(cuid())
  openid       String                  @unique
  unionid      String?                 @unique
  nickname     String?
  avatar       String?
  gender       String?
  city         String?
  province     String?
  country      String?
  status       String                  @default("active")
  lastLogin    DateTime?
  registerTime DateTime?
  appVersion   String?
  remark       String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  isActive     Boolean                 @default(true)
  subUsers     SubUser[]
  systemInfo   UserSystemInfo?
  verification WechatUserVerification?

  @@map("wechat_users")
}

model SubUser {
  id           String       @id @default(cuid())
  wechatUserId String
  username     String?      @unique
  realName     String?
  phone        String?
  email        String?
  age          Int?
  gender       String?
  address      String?
  status       String       @default("active")
  archives     Int          @default(0)
  photos       Int          @default(0)
  reports      Int          @default(0)
  remark       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  isActive     Boolean      @default(true)
  archiveList  Archive[]
  detections   Detection[]
  feedbacks    Feedback[]
  wechatUser   WechatUser   @relation(fields: [wechatUserId], references: [id], onDelete: Cascade)
  coupons      UserCoupon[]

  @@map("sub_users")
}

model UserSystemInfo {
  id           String     @id @default(cuid())
  platform     String?
  system       String?
  version      String?
  SDKVersion   String?
  brand        String?
  model        String?
  screenWidth  Int?
  screenHeight Int?
  windowWidth  Int?
  windowHeight Int?
  pixelRatio   Float?
  language     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wechatUserId String     @unique
  wechatUser   WechatUser @relation(fields: [wechatUserId], references: [id], onDelete: Cascade)

  @@map("user_system_info")
}

model WechatUserVerification {
  id             String     @id @default(cuid())
  wechatUserId   String     @unique
  idNumber       String
  realName       String
  age            Int?
  gender         String?
  address        String?
  identity       String     @default("普通用户")
  status         String     @default("pending")
  subUsers       Int        @default(0)
  archives       Int        @default(0)
  photos         Int        @default(0)
  reports        Int        @default(0)
  unreadMessages Int        @default(0)
  idCardFront    String?
  idCardBack     String?
  idCardHand     String?
  verifyStatus   String     @default("pending")
  verifyTime     DateTime?
  rejectReason   String?
  verifyAdminId  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  verifyAdmin    Admin?     @relation(fields: [verifyAdminId], references: [id])
  wechatUser     WechatUser @relation(fields: [wechatUserId], references: [id], onDelete: Cascade)

  @@map("wechat_user_verifications")
}

model Admin {
  id          String                   @id @default(cuid())
  username    String                   @unique
  password    String
  name        String
  email       String?                  @unique
  phone       String?
  role        String                   @default("admin")
  isActive    Boolean                  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  verifiedIds WechatUserVerification[]

  @@map("admins")
}

model Detection {
  id            String   @id @default(cuid())
  imageUrl      String
  result        String
  confidence    Float
  status        String   @default("pending")
  errorMsg      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  archiveName   String
  detectionTime DateTime @default(now())
  detectionType String   @default("left_hand_thumb")
  remark        String?
  subUserId     String
  subUser       SubUser  @relation(fields: [subUserId], references: [id], onDelete: Cascade)

  @@map("detections")
}

model Archive {
  id            String   @id @default(cuid())
  archiveName   String
  activity      String   @default("medium")
  photoCount    Int      @default(0)
  bodyPart      String   @default("left_hand_thumb")
  detectionTime DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subUserId     String
  subUser       SubUser  @relation(fields: [subUserId], references: [id], onDelete: Cascade)

  @@unique([subUserId, archiveName])
  @@map("archives")
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sort      Int       @default(0)
  isActive  Boolean   @default(true)
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("banners")
}

model News {
  id          String    @id @default(cuid())
  title       String
  content     String
  summary     String?
  coverImage  String?
  author      String?
  viewCount   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    String?
  status      String    @default("draft")
  tags        String[]
  types       String[]

  @@map("news")
}

model Feedback {
  id        String    @id @default(cuid())
  type      String
  title     String
  content   String
  images    String[]
  status    String    @default("pending")
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subUserId String
  subUser   SubUser   @relation(fields: [subUserId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model SystemReply {
  id          String    @id @default(cuid())
  type        String
  content     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  readCount   Int       @default(0)
  status      String    @default("draft")
  targetUsers String    @default("all")
  title       String
  totalCount  Int       @default(0)

  @@map("system_replies")
}

model Coupon {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  type        String
  value       Float
  minAmount   Float?
  maxDiscount Float?
  totalCount  Int
  usedCount   Int          @default(0)
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  channel     String       @default("all")
  description String?
  status      String       @default("pending")
  targetUsers String       @default("all")
  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id        String    @id @default(cuid())
  couponId  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  subUserId String
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  subUser   SubUser   @relation(fields: [subUserId], references: [id], onDelete: Cascade)

  @@unique([subUserId, couponId])
  @@map("user_coupons")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  wechat      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

model OperationLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("operation_logs")
}

model UserReadStatus {
  id        String    @id @default(cuid())
  userId    String
  articleId String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, articleId])
  @@map("user_read_status")
}
